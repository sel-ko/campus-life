# Copy this file to .env (for local development) and fill in your values.
# On Cloudflare Pages, add the same names under Settings > Environment variables.
# Never commit .env: it is in .gitignore.
#
# Every value is optional. Without them the game is fully playable; the
# leaderboard, vendor stalls and analytics are simply hidden.

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# PostHog > Project Settings (use https://eu.i.posthog.com for an EU project)
VITE_POSTHOG_KEY=phc_your_project_key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Your WhatsApp number for "Advertise here": digits only, with country code
VITE_ADVERTISE_WHATSAPP=2348000000000

# The public link to the game, shown on the share card
VITE_GAME_URL=https://campus-life.pages.dev
